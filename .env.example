# Settings for your Secret Santa server. deploy.sh creates .env from this file the first time it runs.
# After changing anything, apply it with: sh deploy.sh

# The address family members use, with no trailing slash. Required.
ORIGIN=https://santa.example.com

# From https://console.anthropic.com. Without it the app still works, but Santa chat is off.
ANTHROPIC_API_KEY=

# The port the container listens on, for your reverse proxy to reach.
HOST_PORT=3000

# Set this to 127.0.0.1 if your reverse proxy runs on this same machine, so nobody can reach the app
# without going through it. Leave it as is if the proxy is on another machine or in another container.
# HOST_BIND=0.0.0.0

# Fills an empty database with a made-up family for testing. To clear it later: sh deploy.sh wipe
# DEMO_MODE=true
